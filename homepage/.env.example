# Copy to .env (git-ignored) and fill in. Never commit the real .env.

# Proxmox: Datacenter → Permissions → API Tokens (see guide)
HOMEPAGE_VAR_PROXMOX_TOKEN_ID=root@pam!homepage
HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET=

# Portainer: My account → Access tokens
HOMEPAGE_VAR_PORTAINER_KEY=
HOMEPAGE_VAR_PORTAINER_ENV=3

# AdGuard Home login
HOMEPAGE_VAR_ADGUARD_USER=
HOMEPAGE_VAR_ADGUARD_PASS=

# Cloudflare: API token with Account → Cloudflare Tunnel → Read
HOMEPAGE_VAR_CF_ACCOUNT_ID=
HOMEPAGE_VAR_CF_TUNNEL_ID=a5fc179c-33dc-40e5-ae3d-3f41171c95e2
HOMEPAGE_VAR_CF_API_TOKEN=
